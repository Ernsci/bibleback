# Required: OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional: use one specific model.
# Leave unset to use the built-in FREE model chain (recommended, costs $0).
# Note: DeepSeek has no free tier on OpenRouter - all deepseek/* models are paid.
# Example paid override: deepseek/deepseek-v3.2
# OPENROUTER_MODEL=

# Optional: port (Render sets this automatically)
# PORT=3000

# Security: shared secret required for API calls.
# Set this on Render and keep the same value in the frontend API_KEY constant.
# Requests without a matching x-api-key header will receive 403 Forbidden.
API_SECRET=bible-ai-v1-secret
